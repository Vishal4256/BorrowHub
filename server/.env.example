# =========================================================================
# BorrowHub Backend Environment Configuration
# Copy this file to .env and configure for local development or production
# =========================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Connection String (Atlas URI for Production, localhost for dev)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/borrowhub?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/borrowhub?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens (Must be 32+ characters in production)
JWT_SECRET=your_jwt_secret_key_here

# Secret authorization key required for creating platform administrator accounts
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Allowed Frontend Origins for CORS (Comma-separated)
# e.g., https://borrowhub.vercel.app,http://localhost:5173
CLIENT_URL=https://borrowhub.vercel.app,http://localhost:5173

# Optional: Google Gemini Generative AI Key (BorrowHub falls back to local MongoDB catalog matcher if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Configuration (Recommended for Render persistent image storage)
# Leave unset in local development to store uploads on local disk
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
