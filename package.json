{
  "name": "borrowhub",
  "version": "1.0.0",
  "description": "BorrowHub - Peer-to-Peer Community Equipment Sharing & AI Planner Platform",
  "private": true,
  "scripts": {
    "postinstall": "cd client && npm install",
    "build": "cd client && npm run build",
    "build:client": "cd client && npm run build",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server install",
    "start:server": "npm --prefix server start",
    "test:server": "npm --prefix server test",
    "lint:client": "npm --prefix client run lint"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

